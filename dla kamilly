        { by: 'pol', out: 'Планетарий звучит волшебно. Я бы с радостью посмотрела на звёздное небо', delta: 12,
          vanya: ['Правда? Я думал, это интересно только мне)', 'Надо будет потом рассказать друг другу, как там'],
          react: { who: 'pol', text: 'Он ловит намёки. Ещё один шаг.' } },
        { by: 'ari', out: 'Классно! Возьмёшь меня с собой?', delta: 10,
          vanya: ['Ого, прямо так? 😄', 'Ну... я не против, наверное. Давай обсудим'],
          react: { who: 'ari', text: 'Смело! Мне нравится.' } },
        { by: 'ksu', out: 'Только не забудь взять скафандр. Там холодно', delta: 5,
          vanya: ['Скафандр уже в шкафу 😄', 'Если серьёзно, это было бы классно'],
          react: { who: 'ksu', text: 'Шутка засчитана, но намёк был мягкий.' } }
      ]
    },
    {
      title: 'Пригласить на свидание',
      prompt: 'Как пригласить Ваню?',
      intro: [
        { th: 'group', who: 'ari', text: 'Всё, Камилла, момент истины' },
        { th: 'group', who: 'ksu', text: 'Приглашай!' },
        { th: 'group', who: 'pol', text: 'Спокойно, у тебя получится. Главное искренне.' }
      ],
      choiceTh: 'group',
      final: true,
      options: [
        { by: 'ari', out: 'Давай сходим вместе в планетарий в субботу? Я угощаю мороженым', delta: 10 },
        { by: 'pol', out: 'Мне было бы приятно провести эту субботу с тобой. Пойдём в планетарий?', delta: 12 },
        { by: 'ksu', out: 'Ваня, пойдёшь со мной в планетарий? Борис нас обязательно отпустит', delta: 10 }
      ]
    }
  ];

  var ENDINGS = {
    great: {
      title: 'Свидание назначено!',
      text: 'Суббота, планетарий и фисташковое мороженое. Подруги в восторге, а Ваня улыбается даже в чате.',
      vanya: ['Да! Очень хочу 😊', 'В субботу в три у входа? А потом идём за фисташковым мороженым', 'Борис остаётся дома, он обещал не обижаться'],
      react: [
        { who: 'ari', text: 'Вот это да! Свидание в планетарии, я в шоке!' },
        { who: 'ksu', text: 'Я кричу в подушку, чтобы соседи не слышали' },
        { who: 'pol', text: 'Мы так рады за тебя, Камилла. Потом расскажешь всё подробно' }
      ]
    },
    ok: {
      title: 'Почти получилось',
      text: 'Ваня не отказал и хочет сходить, осталось договориться о дне. Попробуй ещё раз и прислушайся к подсказкам подруг.',
      vanya: ['Звучит классно! В субботу я пока не уверен, у меня дела', 'Давай созвонимся в пятницу? Очень хочу сходить'],
      react: [
        { who: 'pol', text: 'Это почти да. Он правда хочет сходить, просто занят' },
        { who: 'ari', text: 'В пятницу созвонитесь, и всё решится' },
        { who: 'ksu', text: 'Главное, что не отказал. Мы в тебя верим' }
      ]
    },
    soft: {
      title: 'Пока просто друзья',
      text: 'Ваня готов общаться дальше, но не торопится. С подсказками подруг в следующий раз выйдет лучше.',
      vanya: ['Спасибо, что позвала. Я пока не готов к свиданию', 'Но давай ещё поболтаем, мне с тобой интересно'],
      react: [
        { who: 'ari', text: 'Он не сказал нет. Он сказал: узнаем друг друга лучше' },
        { who: 'pol', text: 'Это тоже хороший знак. Просто нужен ещё один шаг' },
        { who: 'ksu', text: 'Давай сыграем ещё раз и поймаем волну!' }
      ]
    }
  };

  /* ---------- состояние и интерфейс ---------- */
  var TH = { group: $('thGroup'), vanya: $('thVanya') };
  var DOT = { group: $('dotGroup'), vanya: $('dotVanya') };
  var G = { score: 30, facts: [], active: 'group' };
  var RUN = 0;
  var best = 0;
  try { best = parseInt(localStorage.getItem('vanya-best') || '0', 10) || 0; } catch (e) {}

  function wait(r, ms) {
    return new Promise(function (res) { setTimeout(res, ms); }).then(function () { if (r !== RUN) throw new Error('aborted'); });
  }

  function setBar(name) {
    var av = $('barAv');
    av.textContent = '';
    if (name === 'group') {
      var st = el('div', 'stack');
      ['ari', 'ksu', 'pol'].forEach(function (w) { st.appendChild(avatar(w, 34)); });
      av.appendChild(st);
      $('barName').textContent = 'Подружки';
      $('barSub').textContent = 'Арина, Ксюша, Полина и ты';
    } else {
      av.appendChild(avatar('van', 34));
      $('barName').textContent = 'Ваня';
      $('barSub').textContent = 'в сети';
    }
  }

  function scrollDown(th) { th.scrollTop = th.scrollHeight; }

  function setActive(name) {
    G.active = name;
    TH.group.hidden = name !== 'group';
    TH.vanya.hidden = name !== 'vanya';
    $('tabGroup').classList.toggle('on', name === 'group');
    $('tabVanya').classList.toggle('on', name === 'vanya');
    $('tabGroup').setAttribute('aria-selected', name === 'group' ? 'true' : 'false');
    $('tabVanya').setAttribute('aria-selected', name === 'vanya' ? 'true' : 'false');
    DOT[name].hidden = true;
    $('sheet').hidden = true;
    setBar(name);
    scrollDown(TH[name]);
  }

  function bubble(who, text, thread) {
    var row = el('div', 'msg ' + (who === 'kam' ? 'out' : 'in'));
    if (who !== 'kam') row.appendChild(avatar(who, 30));
    var col = el('div', 'col');
    if (who !== 'kam' && thread === 'group') {
      var l = el('span', 'lbl', P[who].name);
      l.style.color = P[who].lab;
      col.appendChild(l);
    }
    col.appendChild(el('div', 'b', text));
    row.appendChild(col);
    return row;
  }

  function typingEl(who) {
    var row = el('div', 'msg in typing');
    row.appendChild(avatar(who, 30));
    var b = el('div', 'b');
    b.appendChild(el('i')); b.appendChild(el('i')); b.appendChild(el('i'));
    var col = el('div', 'col'); col.appendChild(b);
    row.appendChild(col);
    return row;
  }

  async function say(r, thread, who, text) {
    var th = TH[thread];
    if (who !== 'kam') {
      var tp = typingEl(who);
      th.appendChild(tp);
      scrollDown(th);
      await wait(r, clamp(450 + text.length * 14, 650, 1300));
      tp.remove();
    } else {
      await wait(r, 450);
    }
    th.appendChild(bubble(who, text, thread));
    scrollDown(th);
    if (G.active !== thread) DOT[thread].hidden = false;
  }

  function setMeter(v) {
    $('fill').style.width = v + '%';
    $('val').textContent = String(v);
    $('bar').setAttribute('aria-valuenow', String(v));
  }
  function applyDelta(d) {
    G.score = clamp(G.score + d, 0, 100);
    setMeter(G.score);
    var pop = el('span', 'pop ' + (d >= 0 ? 'up' : 'down'), (d >= 0 ? '+' : '') + d);
    document.querySelector('.meter').appendChild(pop);
    setTimeout(function () { pop.remove(); }, 1500);
  }

  function toast(text) {
    var t = el('div', 'toast', text);
    document.querySelector('.threads').appendChild(t);
    setTimeout(function () { t.remove(); }, 2200);
  }
  function addFact(f) {
    if (G.facts.indexOf(f) !== -1) return;
    G.facts.push(f);
    $('factCount').textContent = String(G.facts.length);
    toast('Новая заметка в досье');
  }
  function renderSheet() {
    var s = $('sheet');
    s.textContent = '';
    s.appendChild(el('h2', null, 'Досье на Ваню'));
    if (!G.facts.length) {
      s.appendChild(el('p', null, 'Пока пусто. Слушай подруг: они знают о Ване больше всех.'));
    } else {
      var ul = el('ul');
      G.facts.forEach(function (f) { ul.appendChild(el('li', null, f)); });
      s.appendChild(ul);
    }
    var b = el('button', 'btn alt', 'Закрыть');
    b.type = 'button';
    b.addEventListener('click', function () { s.hidden = true; });
    s.appendChild(b);
  }

  function choose(r, R, idx) {
    return new Promise(function (resolve) {
      var rp = $('reply');
      rp.hidden = false;
      rp.textContent = '';
      var head = el('div', 'rhead');
      head.appendChild(el('span', null, 'Раунд ' + (idx + 1) + ' из ' + ROUNDS.length));
      head.appendChild(el('span', 'rq', R.prompt));
      rp.appendChild(head);
      var btns = [];
      shuffle(R.options.slice()).forEach(function (o) {
        var b = el('button', 'opt');
        b.type = 'button';
        b.style.setProperty('--c', P[o.by].bg);
        b.style.setProperty('--cl', P[o.by].lab);
        b.appendChild(avatar(o.by, 28));
        var tx = el('span', 'ot');
        tx.appendChild(el('span', 'who2', P[o.by].name + ' советует'));
        tx.appendChild(el('span', 'say', (R.prefix || '') + o.out));
        b.appendChild(tx);
        b.addEventListener('click', function () {
          if (r !== RUN) return;
          btns.forEach(function (x) { x.disabled = true; });
          rp.hidden = true;
          resolve(o);
        });
        btns.push(b);
        rp.appendChild(b);
      });
    });
  }

  function clearThreads() {
    TH.group.textContent = '';
    TH.vanya.textContent = '';
    TH.group.appendChild(el('div', 'day', 'Сегодня'));
    TH.vanya.appendChild(el('div', 'day', 'Сегодня'));
  }

  async function playGame(r) {
    try {
      for (var i = 0; i < ROUNDS.length; i++) {
        var R = ROUNDS[i], k, m;
        for (k = 0; k < R.intro.length; k++) {
          m = R.intro[k];
          setActive(m.th);
          await say(r, m.th, m.who, m.text);
          if (m.facts) m.facts.forEach(addFact);
          if (m.facts) renderSheet();
        }
        await wait(r, 300);
        setActive(R.choiceTh);
        var opt = await choose(r, R, i);

        setActive('vanya');
        await say(r, 'vanya', 'kam', (R.prefix || '') + opt.out);

        var replies = opt.vanya, reacts = opt.react ? [opt.react] : [];
        if (R.final) {
          var total = clamp(G.score + opt.delta, 0, 100);
          var key = total >= 80 ? 'great' : (total >= 55 ? 'ok' : 'soft');
          G.ending = key;
          replies = ENDINGS[key].vanya;
          reacts = ENDINGS[key].react;
        }
        for (k = 0; k < replies.length; k++) await say(r, 'vanya', 'van', replies[k]);
        applyDelta(opt.delta);
        await wait(r, 900);
        setActive('group');
        for (k = 0; k < reacts.length; k++) await say(r, 'group', reacts[k].who, reacts[k].text);
        await wait(r, 500);
      }
      finish(r);
    } catch (e) {
      if (!e || e.message !== 'aborted') throw e;
    }
  }

  function finish(r) {
    var E = ENDINGS[G.ending];
    var isBest = G.score > best;
    if (isBest) {
      best = G.score;
      try { localStorage.setItem('vanya-best', String(best)); } catch (e) {}
    }
    $('endTitle').textContent = E.title;
    $('endText').textContent = E.text;
    $('endScore').textContent = 'Симпатия Вани: ' + G.score + ' из 100' + (isBest ? '. Новый личный рекорд!' : '. Лучший результат: ' + best + '.');
    setTimeout(function () { if (r === RUN) $('endCard').hidden = false; }, 700);
    var rp = $('reply');
    rp.hidden = false;
    rp.textContent = '';
    var b = el('button', 'btn', 'Сыграть ещё раз');
    b.type = 'button';
    b.addEventListener('click', startGame);
    rp.appendChild(b);
  }

  function startGame() {
    RUN++;
    var r = RUN;
    G.score = 30;
    G.facts = [];
    G.ending = null;
    $('factCount').textContent = '0';
    setMeter(30);
    $('startCard').hidden = true;
    $('endCard').hidden = true;
    $('reply').hidden = true;
    clearThreads();
    renderSheet();
    setActive('group');
    playGame(r);
  }

  /* ---------- события ---------- */
  var faces = $('faces');
  ['kam', 'ari', 'ksu', 'pol'].forEach(function (w) { faces.appendChild(avatar(w, 44)); });
  $('startBtn').addEventListener('click', startGame);
  $('againBtn').addEventListener('click', startGame);
  $('viewBtn').addEventListener('click', function () { $('endCard').hidden = true; });
  $('tabGroup').addEventListener('click', function () { setActive('group'); });
  $('tabVanya').addEventListener('click', function () { setActive('vanya'); });
  $('dossierBtn').addEventListener('click', function () {
    renderSheet();
    $('sheet').hidden = !$('sheet').hidden;
  });

  clearThreads();
  renderSheet();
  setBar('group');
  setMeter(30);
})();
</script>

</body></html>
