<style>
/* Layout: a title block, then one phone-shaped messenger. Group chat and Vanya's chat are two threads in the same screen; answer options slide in at the bottom like quick replies. */
:root {
  --page: #160f2b;
  --screen: #f6f1ff;
  --card: #ffffff;
  --ink: #2a1b3d;
  --muted: #7c6a95;
  --line: #e4dcf3;
  --kam: #8a5cff;
  --heart: #ff4f9a;
  --peach: #ffb089;
  --font-display: 'Unbounded', 'Trebuchet MS', system-ui, sans-serif;
  --font-body: 'Nunito', system-ui, -apple-system, 'Segoe UI', sans-serif;
  color-scheme: dark;
}
* { box-sizing: border-box; }
html, body { height: auto; }
body {
  background: var(--page);
  color: #fff0e6;
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.45;
  padding-inline: 16px;
  padding-block: 20px 32px;
}
.top { max-width: 420px; margin: 0 auto 16px; }
h1 {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: clamp(1.4rem, 5.5vw, 2rem);
  line-height: 1.1;
  margin: 0;
  text-wrap: balance;
}
h1 span { color: var(--heart); }
.lead { margin: 6px 0 0; color: #c9b3df; font-size: .95rem; }

.phone {
  position: relative;
  width: min(100%, 390px);
  height: 700px;
  height: clamp(580px, 88svh, 720px);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  background: var(--screen);
  color: var(--ink);
  border: 8px solid #0b0618;
  border-radius: 40px;
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(0, 0, 0, .55);
}
.notch { position: absolute; top: 6px; left: 50%; width: 84px; height: 20px; margin-left: -42px; background: #0b0618; border-radius: 12px; z-index: 5; }
.status { display: flex; justify-content: space-between; align-items: center; padding: 8px 22px 0; height: 30px; font-size: 12px; font-weight: 800; color: var(--ink); flex: none; }
.batt { width: 22px; height: 10px; border: 1.5px solid var(--ink); border-radius: 3px; position: relative; }
.batt::after { content: ''; position: absolute; inset: 1.5px; right: 5px; background: var(--ink); border-radius: 1px; }

.appbar { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 6px 14px 8px; flex: none; }
.who { display: flex; align-items: center; gap: 10px; min-width: 0; }
.who .t { min-width: 0; }
.nm { font-weight: 800; font-size: 16px; line-height: 1.15; }
.sub { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.chip { flex: none; font: 800 12px var(--font-body); color: var(--kam); background: #ece4ff; border: 0; border-radius: 999px; padding: 6px 12px; cursor: pointer; }
.chip b { display: inline-block; min-width: 1.4em; margin-left: 4px; padding: 0 5px; border-radius: 99px; background: var(--kam); color: #fff; text-align: center; }

.av { --s: 34px; width: var(--s); height: var(--s); flex: none; border-radius: 50%; display: grid; place-items: center; font-weight: 800; font-size: calc(var(--s) * .4); line-height: 1; }
.stack { display: flex; }
.stack .av { border: 2px solid var(--screen); margin-left: -10px; }
.stack .av:first-child { margin-left: 0; }

.tabs { display: flex; gap: 6px; padding: 0 14px 8px; flex: none; }
.tab { flex: 1; position: relative; font: 800 13px var(--font-body); color: var(--muted); background: transparent; border: 0; border-bottom: 3px solid var(--line); padding: 7px 4px; cursor: pointer; }
.tab.on { color: var(--ink); border-bottom-color: var(--kam); }
.dot { position: absolute; top: 6px; right: 22%; width: 9px; height: 9px; border-radius: 50%; background: var(--heart); }

.meter { position: relative; display: flex; align-items: center; gap: 8px; padding: 0 14px 8px; flex: none; }
.meter svg { width: 20px; height: 20px; fill: var(--heart); flex: none; }
.meter .lab { font-size: 12px; font-weight: 800; color: var(--muted); flex: none; }
.bar { flex: 1; height: 10px; border-radius: 99px; background: var(--line); overflow: hidden; }
.fill { height: 100%; width: 30%; border-radius: 99px; background: linear-gradient(90deg, #ff7fb8, var(--heart)); transition: width .7s ease; }
.val { width: 2.2em; text-align: right; font-weight: 800; font-size: 13px; font-variant-numeric: tabular-nums; }
.pop { position: absolute; right: 14px; top: -14px; font-weight: 800; font-size: 18px; animation: rise 1.4s ease forwards; pointer-events: none; }
.pop.up { color: #0f9a68; }
.pop.down { color: #d6307a; }
@keyframes rise { from { opacity: 0; transform: translateY(8px); } 20% { opacity: 1; } to { opacity: 0; transform: translateY(-14px); } }

.threads { position: relative; flex: 1; min-height: 0; display: flex; background: #efe8fc; border-top: 1px solid var(--line); }
.thread { flex: 1; min-width: 0; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
.day { align-self: center; font-size: 11px; font-weight: 800; color: var(--muted); background: #e4dcf3; border-radius: 99px; padding: 2px 10px; }
.msg { display: flex; gap: 8px; align-items: flex-end; animation: pop .18s ease; }
.msg.out { justify-content: flex-end; }
.col { display: flex; flex-direction: column; gap: 2px; min-width: 0; max-width: 78%; }
.msg.out .col { max-width: 80%; }
.lbl { font-size: 11px; font-weight: 800; padding-left: 4px; }
.b { padding: 9px 13px; border-radius: 18px; font-size: 15px; line-height: 1.35; overflow-wrap: anywhere; background: var(--card); color: var(--ink); border-bottom-left-radius: 6px; box-shadow: 0 1px 0 rgba(42, 27, 61, .06); }
.msg.out .b { background: var(--kam); color: #fff; border-bottom-left-radius: 18px; border-bottom-right-radius: 6px; }
.typing .b { display: flex; gap: 4px; padding: 13px 14px; }
.typing .b i { width: 7px; height: 7px; border-radius: 50%; background: #b3a4cc; animation: bob 1s infinite; }
.typing .b i:nth-child(2) { animation-delay: .15s; }
.typing .b i:nth-child(3) { animation-delay: .3s; }
@keyframes bob { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-4px); } }
@keyframes pop { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

.toast { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); background: var(--ink); color: #fff; font-size: 12px; font-weight: 800; padding: 6px 14px; border-radius: 99px; z-index: 3; white-space: nowrap; animation: pop .2s ease; }
.sheet { position: absolute; inset: 0; z-index: 4; background: var(--screen); padding: 16px; overflow-y: auto; }
.sheet h2 { font-family: var(--font-display); font-weight: 600; font-size: 1rem; margin: 0 0 10px; }
.sheet ul { margin: 0 0 14px; padding-left: 20px; }
.sheet li { margin-bottom: 6px; }
.sheet p { margin: 0 0 12px; color: var(--muted); }

.reply { flex: none; background: var(--card); border-top: 1px solid var(--line); padding: 10px 12px 14px; display: flex; flex-direction: column; gap: 8px; max-height: 58%; overflow-y: auto; }
.rhead { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; font-weight: 800; color: var(--muted); }
.rhead .rq { color: var(--ink); text-align: right; }
.opt { display: flex; align-items: flex-start; gap: 10px; text-align: left; width: 100%; font-family: var(--font-body); color: var(--ink); background: #faf7ff; border: 2px solid var(--c, var(--line)); border-radius: 14px; padding: 8px 10px; cursor: pointer; }
.opt:hover:not(:disabled) { background: #f0e8ff; }
.opt:disabled { opacity: .6; cursor: default; }
.ot { display: flex; flex-direction: column; min-width: 0; }
.who2 { font-size: 11px; font-weight: 800; color: var(--cl, var(--muted)); }
.say { font-size: 14px; font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
.btn { font: 800 15px var(--font-body); color: #fff; background: var(--kam); border: 0; border-radius: 999px; padding: 11px 22px; cursor: pointer; }
.btn.alt { color: var(--kam); background: #ece4ff; }
.btn:hover { filter: brightness(1.06); }
.btn:focus-visible, .opt:focus-visible, .tab:focus-visible, .chip:focus-visible { outline: 3px solid var(--heart); outline-offset: 2px; }

.card { position: absolute; inset: 0; z-index: 6; display: flex; flex-direction: column; justify-content: center; gap: 12px; padding: 44px 24px 24px; background: linear-gradient(165deg, #3b1f63, #7a2f7e 60%, #ff7a8a); color: #fff0e6; }
.card h2 { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.4rem, 7vw, 1.9rem); line-height: 1.12; margin: 0; text-wrap: balance; }
.card p { margin: 0; font-size: 1rem; }
.card .row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
.card .score { font-weight: 800; color: var(--peach); }
.card .btn { background: #fff0e6; color: #3b1f63; }
.card .btn.alt { background: rgba(255, 255, 255, .16); color: #fff0e6; }
.faces { display: flex; }
.faces .av { --s: 44px; margin-left: -8px; border: 3px solid #5a2a78; }
.faces .av:first-child { margin-left: 0; }

@media (prefers-reduced-motion: reduce) {
  .msg, .toast, .typing .b i, .pop { animation: none; }
  .fill { transition: none; }
}
</style>

